rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Checks if the request is from an authenticated user
    function isAdmin() {
      return request.auth != null;
    }

    // Orders: public can create and read (for order history), admin can read, write, delete
    match /orders/{orderId} {
      allow create, read: if true;
      allow write: if isAdmin();
    }

    // Customers: public can create and update (during checkout), only admin can read all
    match /customers/{customerId} {
      allow create, update: if true;
      allow read: if isAdmin();
    }

    // Subscriptions: public can create, only admin can read, write
    match /subscriptions/{subscriptionId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Farmers: public can read, only admin can write
    match /farmers/{farmerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Delivery Zones: public can read, only admin can write
    match /delivery_zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: public can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: public can read, only admin can write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Suppliers: public can create/sign up, admin can read/write/approve
    match /suppliers/{supplierId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Testimonials: public can read, admin can write
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners: public can read, admin can write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings: public can read, admin can write
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons: public can read, only admin can write
    match /coupons/{couponCode} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
